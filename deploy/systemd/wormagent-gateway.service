[Unit]
Description=WormAgent Gateway (v2026.3.19)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/env wormagent gateway
Restart=always
RestartSec=5
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=%h
Environment=TMPDIR=/tmp
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WORMAGENT_GATEWAY_PORT=18789
Environment=WORMAGENT_SYSTEMD_UNIT=wormagent-gateway.service
Environment="WORMAGENT_WINDOWS_TASK_NAME=WormAgent Gateway"
Environment=WORMAGENT_SERVICE_MARKER=wormagent
Environment=WORMAGENT_SERVICE_KIND=gateway
Environment=WORMAGENT_SERVICE_VERSION=2026.3.19

[Install]
WantedBy=default.target
