{
  "name": "@wormagent/synology-chat",
  "version": "2026.3.14",
  "description": "Synology Chat channel plugin for WormAgent",
  "type": "module",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "wormagent": {
    "extensions": [
      "./index.js"
    ],
    "setupEntry": "./setup-entry.js",
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
      "selectionLabel": "Synology Chat (Webhook)",
      "docsPath": "/channels/synology-chat",
      "docsLabel": "synology-chat",
      "blurb": "Connect your Synology NAS Chat to WormAgent with full agent capabilities.",
      "order": 90
    },
    "install": {
      "npmSpec": "@wormagent/synology-chat",
      "localPath": "extensions/synology-chat",
      "defaultChoice": "npm"
    }
  }
}
